# Wonderglobe — optional AI services.
# Every variable is OPTIONAL: the game is fully playable without any of them
# (offline name suggestions, local character replies, browser speech and
# synthesized sounds are used instead, and the UI says so honestly).
#
# These are read ONLY on the server (route handlers under app/api). Never
# prefix them with NEXT_PUBLIC_ — that would ship them to the browser.

# --- Claude (drawing recognition + character chat) -------------------------
ANTHROPIC_API_KEY=
# Model id (default: claude-opus-5-5). Requests use effort "low"; server-side
# refusal fallbacks are enabled automatically on models that support them
# (claude-opus-5-5, claude-opus-5, claude-fable-5-1, claude-sonnet-5-5).
WONDERGLOBE_CLAUDE_MODEL=claude-opus-5-5
# Set to "off" to disable server-side refusal fallbacks.
# WONDERGLOBE_CLAUDE_FALLBACKS=off

# --- ElevenLabs (character voices, animal sounds, speech-to-text) ----------
ELEVENLABS_API_KEY=
# Comma-separated voice ids used for ALL characters. If unset, a built-in list
# of ElevenLabs premade voices is used, grouped by voice type. Each character
# always gets the same voice (hash of its id over the list).
ELEVENLABS_VOICE_IDS=
# Optional per-voice-type lists (override ELEVENLABS_VOICE_IDS for that type):
# ELEVENLABS_VOICE_IDS_SMALL=
# ELEVENLABS_VOICE_IDS_BIG=
# ELEVENLABS_VOICE_IDS_BRIGHT=
# ELEVENLABS_VOICE_IDS_CALM=
# ELEVENLABS_VOICE_IDS_SILLY=
# Text-to-speech model (default: eleven_flash_v2_5).
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
